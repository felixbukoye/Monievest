# ---------------------------------------------------------------------------
# Monievest — local environment (NOT tracked by git; safe for your real key)
#
# 1. Paste your key on the matching *_API_KEY line below.
# 2. Set MARKET_DATA_PROVIDER to that provider's id.
# 3. Save — the dev server picks up .env changes automatically.
#
# Leave everything blank to keep running on the local simulator.
# ---------------------------------------------------------------------------

# simulated | finnhub | polygon | alphavantage | twelvedata
MARKET_DATA_PROVIDER="simulated"

# >>> PASTE YOUR API KEY HERE (only the line matching your provider) <<<
FINNHUB_API_KEY=""
POLYGON_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
TWELVE_DATA_API_KEY=""

# Optional overrides
MARKET_DATA_BASE_URL=""
MARKET_DATA_CACHE_SECONDS="30"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
