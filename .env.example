# ---------------------------------------------------------------------------
# Monievest environment template
#
#   cp .env.example .env.local     then paste your key into .env.local
#
# .env.local is git-ignored (see .gitignore) — never commit a real key.
# Every variable below is OPTIONAL: with none of them set, Monievest runs on
# its local deterministic simulator exactly as before.
#
# These are SERVER-ONLY names (no NEXT_PUBLIC_ prefix), so they are inlined
# into server code only and never shipped to the browser.
# ---------------------------------------------------------------------------

# Which data source to use: simulated | finnhub | polygon | alphavantage | twelvedata
MARKET_DATA_PROVIDER="simulated"

# Paste the key for YOUR provider on the matching line and leave the rest blank.
FINNHUB_API_KEY=""
POLYGON_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
TWELVE_DATA_API_KEY=""

# Optional overrides — sensible defaults are built in for each provider.
MARKET_DATA_BASE_URL=""

# How long (seconds) a quote is cached server-side before a refetch. This is
# also the client poll interval. 45s keeps a 40-symbol refresh inside the free
# Finnhub budget of ~60 calls/minute (one call per symbol, no batch endpoint).
MARKET_DATA_CACHE_SECONDS="60"

# Optional: absolute origin used for metadata / OG image URLs.
# Also used as the redirect target in confirmation emails — set this to your
# deployed URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Accounts (Supabase) — OPTIONAL
#
# With both values set, Monievest requires a sign-in for /app/*, saves every
# user's watchlist, positions, orders, cash and activity to Postgres, and keeps
# each account strictly isolated with Row Level Security.
#
# Leave both blank to run exactly as before: a local demo portfolio stored in
# your browser (guest mode). Nothing breaks, nothing is locked.
#
# These are NEXT_PUBLIC_ on purpose — the anon key is a publishable key meant
# for browsers. Security comes from RLS, NOT from hiding the key. NEVER put the
# service_role key here or anywhere in the app: it bypasses RLS completely.
#
# Where to find them: Supabase dashboard → your project → Settings → API.
# Before first use, run supabase/migrations/0001_init.sql in SQL Editor.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
